{
    "require": {
        "smtp2go-oss/smtp2go-php": "1.3.2"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "auto-scripts": {
            "removeBuild": "rm -rf build/",
            "scopeBuild": "php php-scoper.phar add-prefix",
            "dumpBuildAutoload": "cd build && composer dumpautoload",
            "prefixAutoloadFiles": "php bin/prefix-autoload-files.php"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
